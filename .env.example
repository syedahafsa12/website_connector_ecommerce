# PostgreSQL connection (Supabase-hosted for this POC, but the app talks to it
# as plain PostgreSQL via `pg` — no Supabase SDK for data access).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Supabase Auth only (signup/login/session verification) — NOT used for data access.
# From the Supabase dashboard > Project Settings > API.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-or-publishable-key>

# Model provider (see src/server/agent/model-provider.ts). The agent is written
# against a provider interface so this can be swapped without touching agent logic.
MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5

# Base URL the app is served from (used to build absolute URLs for demo-merchant
# REST/web endpoints that live inside this same Next.js app).
APP_BASE_URL=http://localhost:3000

# Command used to launch the Merchant B MCP server as a child process (stdio transport).
MERCHANT_B_MCP_COMMAND=npx
MERCHANT_B_MCP_ARGS=tsx,scripts/mcp-servers/merchant-b-server.ts

# Connection tester (/connect)
# URL of your deployed Luna Apparel store; shows a "Luna" shortcut on the connect screen.
NEXT_PUBLIC_LUNA_URL=
# Optional dev-only opt-in to test a local site (exact origins, comma separated). Loopback is allowed but never trusted automatically.
CONNECT_ALLOW_LOCAL=
# Optional: secret used to derive stable per-domain ownership tokens (otherwise a local .connect-secret file is created).
CONNECT_SECRET=

# Agent (server-side only; never exposed to the browser). Any Mistral chat model with tool calling works.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-medium-latest
# Optional: shared secret so a merchant server can also verify shopper-approval signatures (see docs/CONNECTION_PROTOTYPE.md).
